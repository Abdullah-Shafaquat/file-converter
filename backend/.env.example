# Copy to .env and adjust. Every value here is read at startup.

APP_ENV=development
APP_NAME=Universal File Converter
API_PREFIX=/api

# --- limits ---------------------------------------------------------------
# Increase MAX_FILE_SIZE_MB for very long PDFs. Uploads stream to disk in
# 1 MB chunks, so a large limit does not mean large memory use.
MAX_FILE_SIZE_MB=500
FILE_RETENTION_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300
MAX_CONCURRENT_JOBS=4
CONVERSION_TIMEOUT_SECONDS=900

# --- storage --------------------------------------------------------------
# Relative paths resolve against the backend/ directory.
UPLOAD_DIR=./temp/uploads
OUTPUT_DIR=./temp/outputs

# --- external tools -------------------------------------------------------
# Only LibreOffice is used, and only for DOC / ODT / RTF / XLS.
# Without it those pairs are hidden from /api/formats rather than faked.
LIBREOFFICE_PATH=soffice

# Kept for completeness; this build is document/image/archive only.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- cors -----------------------------------------------------------------
# Comma-separated. On Hugging Face Spaces set this to your Vercel URL, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
